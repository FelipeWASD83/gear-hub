<Window x:Class="GearHub.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GearHub.Ui"
        Title="Gear Hub" Width="1220" Height="820" MinWidth="980" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{StaticResource Text}" Foreground="{StaticResource Ink}"
        Icon="pack://application:,,,/Assets/icone.ico">
    <Grid>
        <!-- the shadow sits on its own layer so the card's text keeps ClearType -->
        <Border Margin="22" CornerRadius="32" Background="Black">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="Black"/></Border.Effect>
        </Border>
        <Border x:Name="Card" Margin="22" CornerRadius="32" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rim}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="88"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid x:Name="TopBar" Background="Transparent">
                    <TextBlock x:Name="Brand" Style="{StaticResource H2}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="34,30,0,0"/>
                    <ui:Island x:Name="Isle" Margin="0,20,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,26,0">
                        <Button x:Name="MinButton" Style="{StaticResource Round}" Margin="0,0,8,0">
                            <Path Data="M0,0 L10,0" Stroke="{StaticResource Ink2}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource Round}">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource Ink2}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="22,0,10,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Nav" Margin="0,0,10,0"/>
                        </ScrollViewer>
                        <StackPanel x:Name="NavBottom" Grid.Row="1" Margin="0,10,10,0"/>
                    </Grid>
                    <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="18,0,0,0">
                        <ContentControl x:Name="PageHost" Margin="0,0,22,10"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
