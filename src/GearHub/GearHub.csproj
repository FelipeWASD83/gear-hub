<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 26100: the WinRT projection brings Windows.Devices.Lights (LampArray) and Windows.Gaming.Input -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the tray icon (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>GearHub</AssemblyName>
    <RootNamespace>GearHub</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icone\icone.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>Gear Hub</Product>
    <Company>Felipe</Company>
    <Description>Central de Periféricos</Description>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFO0003;CA1416</NoWarn>
    <!-- small footprint in the background: workstation GC without the concurrent background thread -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- our own Main (App.Main) handles the command line before WPF starts -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\icone\icone.ico" Link="Assets\icone.ico" />
    <Resource Include="Fonts\Quicksand-Medium.ttf" />
    <Resource Include="Fonts\Quicksand-Bold.ttf" />
    <!-- next to the exe for the Start menu shortcut and the Desktop Glow setup -->
    <None Include="..\..\icone\icone.ico" Link="icone.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
